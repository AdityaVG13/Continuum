{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://continuum.invalid/schemas/tool-result.schema.json",
  "title": "tool-result",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "call_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "tool": {
      "enum": [
        "read_observation",
        "read_task_context",
        "list_profiles",
        "apply_profile",
        "read_action_result",
        "restore_profile"
      ]
    },
    "status": {
      "enum": [
        "ok",
        "rejected",
        "not_implemented",
        "error"
      ],
      "description": "Tool-interface outcome. ok means the tool returned a valid receipt, which may describe a pending, failed or unknown action. Only appropriate action state and verified readback establish mutation success."
    },
    "data": {
      "type": "object"
    },
    "error_code": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 64
    },
    "message": {
      "type": "string",
      "maxLength": 512
    }
  },
  "required": [
    "schema_version",
    "call_id",
    "request_id",
    "tool",
    "status",
    "data",
    "error_code",
    "message"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          },
          "tool": {
            "const": "read_observation"
          }
        },
        "required": [
          "status",
          "tool"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "observation.schema.json"
          },
          "error_code": {
            "const": null
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          },
          "tool": {
            "const": "read_task_context"
          }
        },
        "required": [
          "status",
          "tool"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "task-context.schema.json"
          },
          "error_code": {
            "const": null
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          },
          "tool": {
            "const": "list_profiles"
          }
        },
        "required": [
          "status",
          "tool"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "config_revision": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "profiles": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "profile_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64,
                      "pattern": "^[A-Za-z0-9_.:-]+$"
                    },
                    "label": {
                      "type": "string",
                      "maxLength": 96
                    },
                    "scope_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64,
                      "pattern": "^[A-Za-z0-9_.:-]+$"
                    },
                    "path_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64,
                      "pattern": "^[A-Za-z0-9_.:-]+$"
                    },
                    "egress_kbit_per_s": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 10000000
                    },
                    "max_lease_ms": {
                      "type": "integer",
                      "minimum": 1000,
                      "maximum": 60000
                    },
                    "restorable": {
                      "const": true
                    }
                  },
                  "required": [
                    "profile_id",
                    "label",
                    "scope_id",
                    "path_id",
                    "egress_kbit_per_s",
                    "max_lease_ms",
                    "restorable"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1,
                "maxItems": 8
              }
            },
            "required": [
              "config_revision",
              "profiles"
            ],
            "additionalProperties": false
          },
          "error_code": {
            "const": null
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          },
          "tool": {
            "const": "apply_profile"
          }
        },
        "required": [
          "status",
          "tool"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "action_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_.:-]+$"
              },
              "request_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_.:-]+$"
              },
              "state": {
                "enum": [
                  "admitted",
                  "applying",
                  "applied",
                  "rejected",
                  "restoring",
                  "restored",
                  "expired",
                  "conflict",
                  "failed",
                  "unknown"
                ],
                "description": "Actual action state. unknown means the mutation outcome is ambiguous and requires state reconciliation; it is not a proven failure or permission to repeat the mutation."
              },
              "lease_id": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 64
              },
              "config_revision": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "readback_verified": {
                "type": "boolean"
              },
              "verification_observation_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[A-Za-z0-9_.:-]+$"
                },
                "maxItems": 16,
                "uniqueItems": true
              },
              "message": {
                "type": "string",
                "maxLength": 512
              }
            },
            "required": [
              "action_id",
              "request_id",
              "state",
              "lease_id",
              "config_revision",
              "readback_verified",
              "verification_observation_ids",
              "message"
            ],
            "additionalProperties": false
          },
          "error_code": {
            "const": null
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          },
          "tool": {
            "const": "read_action_result"
          }
        },
        "required": [
          "status",
          "tool"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "action_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_.:-]+$"
              },
              "request_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_.:-]+$"
              },
              "state": {
                "enum": [
                  "admitted",
                  "applying",
                  "applied",
                  "rejected",
                  "restoring",
                  "restored",
                  "expired",
                  "conflict",
                  "failed",
                  "unknown"
                ],
                "description": "Actual action state. unknown means the mutation outcome is ambiguous and requires state reconciliation; it is not a proven failure or permission to repeat the mutation."
              },
              "lease_id": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 64
              },
              "config_revision": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "readback_verified": {
                "type": "boolean"
              },
              "verification_observation_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[A-Za-z0-9_.:-]+$"
                },
                "maxItems": 16,
                "uniqueItems": true
              },
              "message": {
                "type": "string",
                "maxLength": 512
              }
            },
            "required": [
              "action_id",
              "request_id",
              "state",
              "lease_id",
              "config_revision",
              "readback_verified",
              "verification_observation_ids",
              "message"
            ],
            "additionalProperties": false
          },
          "error_code": {
            "const": null
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          },
          "tool": {
            "const": "restore_profile"
          }
        },
        "required": [
          "status",
          "tool"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "action_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_.:-]+$"
              },
              "request_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_.:-]+$"
              },
              "state": {
                "enum": [
                  "admitted",
                  "applying",
                  "applied",
                  "rejected",
                  "restoring",
                  "restored",
                  "expired",
                  "conflict",
                  "failed",
                  "unknown"
                ],
                "description": "Actual action state. unknown means the mutation outcome is ambiguous and requires state reconciliation; it is not a proven failure or permission to repeat the mutation."
              },
              "lease_id": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 64
              },
              "config_revision": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "readback_verified": {
                "type": "boolean"
              },
              "verification_observation_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[A-Za-z0-9_.:-]+$"
                },
                "maxItems": 16,
                "uniqueItems": true
              },
              "message": {
                "type": "string",
                "maxLength": 512
              }
            },
            "required": [
              "action_id",
              "request_id",
              "state",
              "lease_id",
              "config_revision",
              "readback_verified",
              "verification_observation_ids",
              "message"
            ],
            "additionalProperties": false
          },
          "error_code": {
            "const": null
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "not_implemented",
              "error",
              "rejected"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          },
          "error_code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        }
      }
    }
  ]
}
