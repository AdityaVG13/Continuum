[
  {
    "type": "object",
    "name": "ruleset",
    "description": "Compiled deterministic ruleset for agent-aware traffic shaping. All matchers and actions must be in scope and allowlisted.",
    "required": ["ruleset_id", "scope_id", "path_id", "revision", "created_at_ms", "rules"],
    "additionalProperties": false,
    "properties": {
      "ruleset_id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9_.:-]+$"},
      "scope_id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9_.:-]+$"},
      "path_id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9_.:-]+$"},
      "revision": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
      "created_at_ms": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
      "rules": {
        "type": "array",
        "minItems": 0,
        "maxItems": 256,
        "items": {
          "type": "object",
          "required": ["rule_id", "enabled", "priority", "match", "action"],
          "additionalProperties": false,
          "properties": {
            "rule_id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9_.:-]+$"},
            "enabled": {"type": "boolean"},
            "priority": {"type": "integer", "minimum": 0, "maximum": 10000},
            "match": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "process_name": {"type": "string", "maxLength": 128},
                "sni": {"type": "string", "maxLength": 256},
                "dst_ip_cidr": {"type": "string", "maxLength": 64},
                "dst_port": {"type": "integer", "minimum": 1, "maximum": 65535},
                "proto": {"type": "string", "enum": ["tcp", "udp", "any"]},
                "flow_class": {"type": "string", "enum": ["agent", "api", "bulk", "update", "stream", "unknown"]}
              }
            },
            "action": {
              "type": "object",
              "required": ["kind"],
              "additionalProperties": false,
              "properties": {
                "kind": {"type": "string", "enum": ["prioritize", "deprioritize", "limit_rate", "mark", "noop"]},
                "rate_kbit": {"type": "integer", "minimum": 0, "maximum": 1000000},
                "dscp": {"type": "integer", "minimum": 0, "maximum": 63},
                "rationale": {"type": "string", "maxLength": 256}
              }
            },
            "confidence": {"type": "number", "minimum": 0, "maximum": 1},
            "learned": {"type": "boolean"}
          }
        }
      }
    }
  }
]
