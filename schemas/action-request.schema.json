{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://continuum.invalid/schemas/action-request.schema.json",
  "title": "action-request",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "tool": {
          "const": "apply_profile"
        },
        "arguments": {
          "type": "object",
          "properties": {
            "request_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            },
            "scope_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            },
            "path_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            },
            "profile_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            },
            "observation_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            },
            "task_revision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "route_epoch": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "config_revision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "lease_ms": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 60000
            },
            "rationale": {
              "type": "string",
              "maxLength": 512
            }
          },
          "required": [
            "request_id",
            "scope_id",
            "path_id",
            "profile_id",
            "observation_id",
            "task_revision",
            "route_epoch",
            "config_revision",
            "lease_ms",
            "rationale"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "tool",
        "arguments"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "tool": {
          "const": "restore_profile"
        },
        "arguments": {
          "type": "object",
          "properties": {
            "request_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            },
            "scope_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            },
            "lease_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            },
            "expected_revision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "observation_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            },
            "rationale": {
              "type": "string",
              "maxLength": 512
            }
          },
          "required": [
            "request_id",
            "scope_id",
            "lease_id",
            "expected_revision",
            "observation_id",
            "rationale"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "tool",
        "arguments"
      ],
      "additionalProperties": false
    }
  ]
}
