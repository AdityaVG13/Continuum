{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://continuum.invalid/schemas/workload-result.schema.json",
  "title": "workload-result",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "task_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "decision": {
      "enum": [
        "ready",
        "hold",
        "insufficient_evidence"
      ]
    },
    "findings": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "properties": {
          "finding_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "severity": {
            "enum": [
              "blocker",
              "warning",
              "informational"
            ]
          },
          "summary": {
            "type": "string",
            "maxLength": 512
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            },
            "minItems": 1,
            "maxItems": 8,
            "uniqueItems": true
          }
        },
        "required": [
          "finding_id",
          "severity",
          "summary",
          "evidence_ids"
        ],
        "additionalProperties": false
      }
    },
    "missing_evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[A-Za-z0-9_.:-]+$"
      },
      "maxItems": 16,
      "uniqueItems": true
    },
    "summary": {
      "type": "string",
      "maxLength": 2048
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "task_id",
    "task_revision",
    "decision",
    "findings",
    "missing_evidence_ids",
    "summary"
  ],
  "additionalProperties": false
}
