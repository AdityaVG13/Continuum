{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://continuum.invalid/schemas/observation.schema.json",
  "title": "observation",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "observation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "scope_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "path_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "route_epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "sampled_at_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "window_ms": {
      "type": "integer",
      "minimum": 100,
      "maximum": 60000
    },
    "source": {
      "enum": [
        "synthetic_fixture",
        "live_collector"
      ]
    },
    "sample_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000
    },
    "baseline_ready": {
      "type": "boolean"
    },
    "gateway_rtt_p95_ms": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1000000
    },
    "remote_rtt_p95_ms": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1000000
    },
    "remote_idle_rtt_p95_ms": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1000000
    },
    "app_echo_p95_ms": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1000000
    },
    "app_idle_echo_p95_ms": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1000000
    },
    "provider_elapsed_ms": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1000000
    },
    "uplink_utilization": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "loss_fraction": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "consecutive_bad_windows": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "notes": {
      "type": "string",
      "maxLength": 512
    }
  },
  "required": [
    "schema_version",
    "observation_id",
    "session_id",
    "run_id",
    "scope_id",
    "path_id",
    "route_epoch",
    "sampled_at_ms",
    "window_ms",
    "source",
    "sample_count",
    "baseline_ready",
    "gateway_rtt_p95_ms",
    "remote_rtt_p95_ms",
    "remote_idle_rtt_p95_ms",
    "app_echo_p95_ms",
    "app_idle_echo_p95_ms",
    "provider_elapsed_ms",
    "uplink_utilization",
    "loss_fraction",
    "consecutive_bad_windows",
    "notes"
  ],
  "additionalProperties": false
}
