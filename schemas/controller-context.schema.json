{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://continuum.invalid/schemas/controller-context.schema.json",
  "title": "controller-context",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "example_only": {
      "type": "boolean"
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "now_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "decision_deadline_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "model_role": {
      "const": "controller"
    },
    "observation": {
      "$ref": "observation.schema.json"
    },
    "task": {
      "$ref": "task-context.schema.json"
    },
    "available_profiles": {
      "type": "object",
      "properties": {
        "config_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "profiles": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "profile_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_.:-]+$"
              },
              "label": {
                "type": "string",
                "maxLength": 96
              },
              "scope_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_.:-]+$"
              },
              "path_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_.:-]+$"
              },
              "egress_kbit_per_s": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000000
              },
              "max_lease_ms": {
                "type": "integer",
                "minimum": 1000,
                "maximum": 60000
              },
              "restorable": {
                "const": true
              }
            },
            "required": [
              "profile_id",
              "label",
              "scope_id",
              "path_id",
              "egress_kbit_per_s",
              "max_lease_ms",
              "restorable"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 8
        }
      },
      "required": [
        "config_revision",
        "profiles"
      ],
      "additionalProperties": false
    },
    "active_lease_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 64
    },
    "remaining_incident_turns": {
      "type": "integer",
      "minimum": 0,
      "maximum": 16
    },
    "allowed_tools": {
      "type": "array",
      "items": {
        "enum": [
          "read_observation",
          "read_task_context",
          "list_profiles",
          "apply_profile",
          "read_action_result",
          "restore_profile"
        ]
      },
      "maxItems": 6,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "example_only",
    "session_id",
    "request_id",
    "now_ms",
    "decision_deadline_ms",
    "model_role",
    "observation",
    "task",
    "available_profiles",
    "active_lease_id",
    "remaining_incident_turns",
    "allowed_tools"
  ],
  "additionalProperties": false
}
