{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://continuum.invalid/schemas/task-context.schema.json",
  "title": "task-context",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "task_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "state": {
      "enum": [
        "running",
        "waiting",
        "checkpointed",
        "completed",
        "failed"
      ]
    },
    "semantic_goal": {
      "type": "string",
      "maxLength": 2048
    },
    "pending_step_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "completed_steps": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "remaining_steps": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "deadline_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "quality_floor": {
      "type": "string",
      "maxLength": 512
    },
    "input_object_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[A-Za-z0-9_.:-]+$"
      },
      "maxItems": 32,
      "uniqueItems": true
    },
    "remote_dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[A-Za-z0-9_.:-]+$"
      },
      "maxItems": 16,
      "uniqueItems": true
    },
    "local_eligible": {
      "type": "boolean"
    },
    "side_effect_class": {
      "enum": [
        "pure",
        "read_only",
        "idempotent_external",
        "unknown_external"
      ]
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "task_id",
    "task_revision",
    "state",
    "semantic_goal",
    "pending_step_id",
    "completed_steps",
    "remaining_steps",
    "deadline_ms",
    "quality_floor",
    "input_object_ids",
    "remote_dependencies",
    "local_eligible",
    "side_effect_class"
  ],
  "additionalProperties": false
}
