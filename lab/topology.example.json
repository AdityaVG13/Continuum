{
  "schema_version": "1.0",
  "status": "design_example_not_deployed",
  "name": "continuum-owned-upload-lab",
  "direction": "client_to_relay",
  "requires_target_calibration": true,
  "scope": {
    "kind": "dedicated_linux_namespaces_or_vm",
    "owned_scope_id": "lab-uplink-example",
    "venue_network_mutation_allowed": false,
    "interface_names": "resolve_during_implementation_do_not_guess"
  },
  "nodes": [
    {"id": "agent-client", "role": "Goose controller and separate Meta workload sessions"},
    {"id": "owned-shaper", "role": "finite profile actuator and independent watchdog"},
    {"id": "lab-bottleneck", "role": "separately controlled impairment plane"},
    {"id": "tool-relay", "role": "owned tool service and optional future evidence relay"},
    {"id": "meta-provider", "role": "actual eligible configured Meta API"},
    {"id": "evaluator", "role": "isolated management and measurement collector"}
  ],
  "data_paths": {
    "core_meta_https": ["agent-client", "owned-shaper", "lab-bottleneck", "meta-provider"],
    "core_tool_reads": ["agent-client", "owned-shaper", "lab-bottleneck", "tool-relay"],
    "optional_coded_evidence": ["agent-client", "owned-shaper", "lab-bottleneck", "tool-relay"]
  },
  "traffic_policy": {
    "controller_calls_cross_declared_bottleneck": true,
    "workload_calls_cross_declared_bottleneck": true,
    "bulk_upload_shares_bottleneck": true,
    "management_is_separate": true,
    "core_requires_application_relay": false,
    "optional_relay_https_to_meta": "ordinary_documented_provider_protocol",
    "raptorq_enabled": false
  },
  "measurements": ["gateway_probe", "remote_probe", "owned_application_echo", "model_call_duration", "tool_call_duration", "offered_bulk_load", "delivered_bulk_bytes", "owned_queue_readback"],
  "experiment_profiles": ["idle", "sustained_upload_congestion", "brief_upload_burst", "controlled_service_delay", "stale_observations", "route_change", "complete_outage"],
  "calibration": {
    "bottleneck_rate_bps": null,
    "baseline_delay_ms": null,
    "queue_limit": null,
    "sqm_profile_rate_bps": null,
    "goodput_floor_bps": null,
    "lease_limit_ms": null,
    "note": "Null values are intentionally unresolved; implementation must refuse activation until an explicit calibrated profile is supplied."
  }
}
